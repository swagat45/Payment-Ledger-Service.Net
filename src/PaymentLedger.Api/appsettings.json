{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=payment_ledger;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "TreasuryWallet": {
    "UserEmail": "treasury@paymentledger.local",
    "FullName": "Payment Ledger Treasury",
    "Currencies": [ "USD" ]
  },
  "Outbox": {
    "Enabled": true,
    "IntervalSeconds": 5,
    "BatchSize": 50,
    "LockDurationSeconds": 30,
    "MaxRetries": 5
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "payment-ledger.events",
    "GroupId": "payment-ledger-group",
    "Enabled": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}

