            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 35.50,\n  \"currency\": \"USD\",\n  \"description\": \"Payment for purchase order #1001\",\n  \"metadata\": \"{\\\"orderId\\\":\\\"PO-1001\\\"}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets/{{walletId}}/debit",
              "host": [
