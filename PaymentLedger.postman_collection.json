                "{{walletId}}",
                "debit"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Debit Wallet (Idempotency Replay Verification)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Status code is 200 OK (Cached idempotency return)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Same transaction returned without re-debiting', function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.transactionId).to.eql(pm.collectionVariables.get('transactionId'));",
                  "});"
                ],
