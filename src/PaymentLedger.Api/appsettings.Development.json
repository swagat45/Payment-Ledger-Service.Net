{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=payment_ledger_dev;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "TreasuryWallet": {
    "Currencies": [ "USD", "INR" ]
  },
  "Outbox": {
    "Enabled": true,
    "IntervalSeconds": 5,
    "BatchSize": 50,
    "LockDurationSeconds": 30,
    "MaxRetries": 5
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "payment-ledger.events",
    "GroupId": "payment-ledger-group",
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}


