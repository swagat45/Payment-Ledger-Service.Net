    {
      "name": "4. Financial Transactions",
      "item": [
        {
          "name": "Credit Wallet (From Treasury)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.variables.set('creditIdemKey', 'credit-key-' + Date.now() + '-' + Math.floor(Math.random() * 10000));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data) {",
                  "    pm.collectionVariables.set('transactionId', jsonData.data.transactionId);",
                  "    console.log('Saved transactionId: ' + jsonData.data.transactionId);",
                  "}",
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Transaction amount and balance updated', function () {",
                  "    pm.expect(jsonData.data.amount).to.eql(100.00);",
                  "    pm.expect(jsonData.data.status).to.eql('Posted');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{creditIdemKey}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "credit-{{$timestamp}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100.00,\n  \"currency\": \"USD\",\n  \"description\": \"Initial account deposit from Treasury\",\n  \"metadata\": \"{\\\"source\\\":\\\"bank_transfer\\\"}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets/{{walletId}}/credit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "wallets",
                "{{walletId}}",
                "credit"
              ]
            }
          },
          "response": []
        },
